{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nyanitor",
  "version": "../package.json",
  "identifier": "io.github.nerohee.nyanitor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nyanitor",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 540,
        "center": true,
        "preventOverflow": true,
        "backgroundColor": "#fbf8f3",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
